FROM node:22-alpine AS build
WORKDIR /app
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_LOCAL_AI_BASE_URL=http://localhost:11434
ARG VITE_LOCAL_AI_CHAT_MODEL=granite4:3b
ARG VITE_LOCAL_AI_CODE_MODEL=granite4:3b
ARG VITE_LOCAL_AI_GEMMA_MODEL=granite4:3b
ARG VITE_OMEGA_OLLAMA_BASE_URL=http://localhost:11434
ARG VITE_OMEGA_OLLAMA_MODEL=granite4:3b
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY \
    VITE_LOCAL_AI_BASE_URL=$VITE_LOCAL_AI_BASE_URL \
    VITE_LOCAL_AI_CHAT_MODEL=$VITE_LOCAL_AI_CHAT_MODEL \
    VITE_LOCAL_AI_CODE_MODEL=$VITE_LOCAL_AI_CODE_MODEL \
    VITE_LOCAL_AI_GEMMA_MODEL=$VITE_LOCAL_AI_GEMMA_MODEL \
    VITE_OMEGA_OLLAMA_BASE_URL=$VITE_OMEGA_OLLAMA_BASE_URL \
    VITE_OMEGA_OLLAMA_MODEL=$VITE_OMEGA_OLLAMA_MODEL
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY config/nginx.ibm.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
