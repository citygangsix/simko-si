# Copy to .env. Never commit real values.
VAST_API_KEY=
PODCODER_REMOTE=http://127.0.0.1:8787
LOCAL_PORT=8788
# Optional SSH target for post-Confirm-Rent install. Leave blank in git.
PODCODER_SSH_HOST=
PODCODER_SSH_PORT=
PODCODER_SSH_USER=root
# PODCODER_SSH_KEY=
# local = Aspire granite4.2:8b Q4. cloud = granite4.2:8b-q8_0. Optional override:
PODCODER_COMPUTE=cloud
PODCODER_MODEL=
# Optional. Dedicated PodCoder Supabase project: wxvjajecvklfjxppawdx
# https://wxvjajecvklfjxppawdx.supabase.co
# Leave both values blank in git. Blank keeps the local JSON cache.
# Do not use the Artemis/Omega project nexkymqahpkvzzlvivfi.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# aspire = home machine with 4-hour backups. cloud = write-through notes.
PODCODER_PROFILE=aspire
PODCODER_WORKSPACE=
PODCODER_FETCH_ALLOW=
# Web push. Blank stays on the local notification stub.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_ENDPOINT=
# SMTP. Blank stays on the dev inbox.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Cursor handoff. Blank keeps the agent on local Granite.
CURSOR_API_KEY=
# xAI Grok. Blank keeps chat, translator, sessions, the agent, and Aider on local Ollama Granite.
# The owner pays per token. Never commit a real key.
# Default model in code is grok-4.3. Set XAI_MODEL=grok-4.7 for the flagship.
XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=
# Connector stubs. Leave blank. Do not commit real values.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
REST_CONNECTOR_BASE_URL=
# Optional speaker labels. Blank uses the diarization stub.
HF_TOKEN=

