VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Firebase Web configuration is browser-visible but environment-specific. Keep
# even public identifiers out of this transfer template and inject them at build.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_SDK_VERSION=12.1.0

# Owner dashboard local auth. Values are SHA-256 hex hashes, not plaintext.
VITE_OWNER_EMAIL_HASH=
VITE_OWNER_PASSWORD_HASH=
VITE_OWNER_RECOVERY_HINT=

# Local AI defaults. Local Ollama-compatible AI is the default provider after setup.

# Optional RunPod bring-your-own-account integration. Keep the key in protected
# server credential storage; never expose it through VITE_* browser variables.
RUNPOD_API_KEY=
RUNPOD_API_BASE_URL=https://rest.runpod.io/v1
RUNPOD_ALLOW_PAID_MUTATIONS=false
RUNPOD_MAX_HOURLY_USD=0.50
RUNPOD_MAX_SESSION_HOURS=2
RUNPOD_MAX_SESSION_SPEND_USD=1.00
RUNPOD_REQUIRE_DEDICATED_GPU=true
RUNPOD_REQUIRE_CODING_RUNTIME=true
RUNPOD_CODING_TEMPLATE_ID=
RUNPOD_CODING_IMAGE=
RUNPOD_CODING_MODEL=granite4:3b
# Restart-safe gateway-to-Pod credentials. Generate separate random values of
# at least 32 characters and keep them only in protected server storage.
RUNPOD_POD_AGENT_BEARER_TOKEN=
RUNPOD_POD_AGENT_APPROVAL_TOKEN=
AI_PROVIDER=local
# Applications use the canonical Python agent by default. Set to ollama only
# for the explicit compatibility fallback.
LOCAL_AI_TRANSPORT=canonical
CANONICAL_AGENT_URL=http://127.0.0.1:8793
CANONICAL_AGENT_BEARER_TOKEN=
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_CHAT_MODEL=llama3.1:8b
LOCAL_AI_CODE_MODEL=qwen2.5-coder:7b
LOCAL_AI_GEMMA_MODEL=gemma2:9b
LOCAL_AI_TIMEOUT_MS=60000
ENABLE_LOCAL_AI=true
ENABLE_AI_ANALYSIS_AFTER_DOWNLOAD=true
CHATGPT_TERMINAL_ENABLED=false
CODEX_TERMINAL_ENABLED=false

# Vite mirrors for browser-side Omega defaults.
VITE_AI_PROVIDER=local
VITE_LOCAL_AI_TRANSPORT=canonical-gateway
VITE_CANONICAL_AGENT_GATEWAY_URL=http://127.0.0.1:8791
VITE_CANONICAL_AGENT_REPOSITORY_ID=

# Owner-only website-to-local-agent bridge. The gateway validates the signed
# Supabase user token and maps only this immutable owner UUID to GitHub.
GRANITE_SUPABASE_URL=
GRANITE_SUPABASE_PUBLISHABLE_KEY=
GRANITE_SUPABASE_OWNER_USER_ID=
GRANITE_GITHUB_OWNER_USER_ID=
KOKORO_TTS_ENABLED=false
KOKORO_TTS_URL=http://127.0.0.1:8880
KOKORO_TTS_VOICE=af_heart
KOKORO_TTS_MANAGED=false
KOKORO_TTS_RUNTIME_DIR=
VITE_LOCAL_AI_BASE_URL=http://localhost:11434
VITE_LOCAL_AI_CHAT_MODEL=llama3.1:8b
VITE_LOCAL_AI_CODE_MODEL=qwen2.5-coder:7b
VITE_LOCAL_AI_GEMMA_MODEL=gemma2:9b
VITE_LOCAL_AI_TIMEOUT_MS=60000
VITE_ENABLE_LOCAL_AI=true
VITE_ENABLE_AI_ANALYSIS_AFTER_DOWNLOAD=true
VITE_CHATGPT_TERMINAL_ENABLED=false
VITE_CODEX_TERMINAL_ENABLED=false
VITE_OMEGA_OLLAMA_BASE_URL=http://localhost:11434
VITE_OMEGA_OLLAMA_MODEL=llama3.1:8b

# IBM Granite through any OpenAI-compatible local endpoint. For an IBM host,
# copy config/ibm-granite.example.env to a secret-managed runtime environment.
# Do not expose an unauthenticated inference endpoint to the public internet.
IBM_GRANITE_MODEL=granite4:3b
IBM_GRANITE_BASE_URL=http://granite:11434
IBM_GRANITE_CONTEXT_LENGTH=8192

# Hosted public chat routes through the Supabase Artemis hybrid endpoint.
VITE_ENABLE_OPENAI_FALLBACK=true

# Optional localhost bridge for Hermes terminal/file/build actions.
VITE_HERMES_HANDS_URL=http://127.0.0.1:8765

# Artemis local phone delivery. SignalWire is the only active real provider for now.
# Queueing SMS/MMS/call updates does not send anything.
# Actual sends require an approved item and: npm run artemis -- sms-send|mms-send|call-send "id"
ARTEMIS_PHONE_PROVIDER=signalwire
TWILIO_COMPATIBLE_API_BASE_URL=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_AUTH_TOKEN=
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_LAML_BASE_URL=
SIGNALWIRE_FROM_NUMBER=
SIGNALWIRE_TO_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ARTEMIS_USER_PHONE=
ARTEMIS_OWNER_PHONE=
ARTEMIS_PUBLIC_BASE_URL=

# Artemis Telegram connector. Disabled by default; health checks only until explicitly enabled later.
ARTEMIS_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_DEFAULT_CHAT_ID=
# When Telegram is enabled, /code and /codex launch a read-only Codex terminal planner before the approval-gated Artemis mission.
TELEGRAM_CODEX_TERMINAL_ENABLED=true
# Also open or reuse a visible macOS Terminal window running Codex for the exact target project.
TELEGRAM_CODEX_OPEN_TERMINAL_ENABLED=true
# Also open or reuse the Codex desktop app for the project.
TELEGRAM_CODEX_APP_WINDOW_ENABLED=true
# Keep the bridge responsive for Telegram 1/2/3 menu choices; enable only if you also want a separate blocking codex exec planner.
TELEGRAM_CODEX_EXEC_PLANNER_ENABLED=false
# Optional comma-separated aliases, e.g. asap=/Users/you/Projects/asap,shop=/Users/you/Projects/shop
ARTEMIS_PROJECT_ALIASES=
ARTEMIS_ALLOWED_PROJECT_ROOTS=

# Artemis WhatsApp Cloud API connector. Disabled by default; health checks only until explicitly enabled later.
ARTEMIS_WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ALLOWED_RECIPIENTS=
WHATSAPP_TO_NUMBER=
WHATSAPP_GRAPH_VERSION=v25.0

# Future Artemis Communication OS placeholders. Leave blank until provider adapters exist.
ARTEMIS_EMAIL_ENABLED=false
EMAIL_PROVIDER=
EMAIL_ALLOWED_RECIPIENTS=
ARTEMIS_PUSH_ENABLED=false
PUSH_PROVIDER=
PUSH_ALLOWED_DEVICE_IDS=

# Optional local Granite GitHub agent. Never place real values in this file.
# Store the client secret and three distinct encryption/signing keys server-side.
GRANITE_GITHUB_APP_CLIENT_ID=
GRANITE_GITHUB_APP_CLIENT_SECRET=
GRANITE_GITHUB_APP_SLUG=
GRANITE_GITHUB_APP_CALLBACK_URL=http://127.0.0.1:8791/auth/callback
GRANITE_GITHUB_PUBLIC_ORIGIN=http://127.0.0.1:8791
GRANITE_GITHUB_APPLICATION_ORIGINS=http://localhost:8080
GRANITE_GITHUB_SECURE_COOKIES=false
GRANITE_GITHUB_DATA_KEY=replace_with_32_byte_base64url_or_64_hex_key
GRANITE_GITHUB_SESSION_KEY=replace_with_a_different_32_byte_base64url_or_64_hex_key
GRANITE_GITHUB_AUDIT_KEY=replace_with_a_third_32_byte_base64url_or_64_hex_key
GRANITE_GITHUB_STATE_DIR=.granite-github-agent
GRANITE_GITHUB_REPOSITORIES_DIR=.granite-github-agent/repositories
GRANITE_GITHUB_MAX_TOOL_ROUNDS=8
GRANITE_OLLAMA_URL=http://127.0.0.1:11434
GRANITE_OLLAMA_MODEL=granite4:3b
GRANITE_CODEX_CLOUD_URL=https://chatgpt.com/codex
