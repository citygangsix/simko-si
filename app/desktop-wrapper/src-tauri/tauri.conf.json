{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simko SI",
  "version": "0.1.0",
  "identifier": "com.simkosi.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/simko-backend"
    ],
    "publisher": "Simko SI",
    "shortDescription": "Simko SI",
    "longDescription": "Simko SI desktop app with first-run downloads for coding tools, Ollama, Granite and ComfyUI.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": null
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null
    }
  }
}
