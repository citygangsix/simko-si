SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
OPENAI_API_KEY=your_openai_api_key
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
AI_PROVIDER=local
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_CHAT_MODEL=llama3.1:8b
LOCAL_AI_CODE_MODEL=qwen2.5-coder:7b
LOCAL_AI_GEMMA_MODEL=gemma2:9b
LOCAL_AI_TIMEOUT_MS=60000
ENABLE_LOCAL_AI=true
ENABLE_AI_ANALYSIS_AFTER_DOWNLOAD=false
CHATGPT_TERMINAL_ENABLED=false
CODEX_TERMINAL_ENABLED=false
WORKER_POLL_INTERVAL_MS=5000
WORKER_SEGMENT_SECONDS=300
WORKER_CONCURRENCY=1
WORKER_CHUNK_CONCURRENCY=1
WORKER_CHUNK_COOLDOWN_MS=750
WORKER_CHILD_NICE_LEVEL=15
WHISPER_THREADS=2
WORKER_RETRY_FAILED=false
WORKER_RETRY_FAILED_AFTER_MINUTES=60
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=

