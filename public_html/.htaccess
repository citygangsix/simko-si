DirectoryIndex index.html index.php default.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the private folder is ever unpacked inside the site root, refuse it.
  RewriteRule ^simkosi-private(/|$) - [F,L]

  # Old source copies and the staging site's folder are not part of the live site.
  RewriteCond %{HTTP_HOST} ^(www\.)?simkosi\.com$ [NC]
  RewriteRule ^(_backups|staging)(/|$) - [F,L]

  # HTTPS is terminated on Hostinger. Skip the loopback server used for local tests.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$ [NC]
  RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^api/auth/?$ api/auth.php [L]
  RewriteRule ^api/family/?$ api/family.php [L]
  RewriteRule ^api/sessions/?$ api/sessions.php [L]
  RewriteRule ^api/simco/turn/?$ api/chat.php [L]
  RewriteRule ^api/memory/?$ api/memory.php [L]
  RewriteRule ^api/platform/?$ api/platform.php [L]
  RewriteRule ^api/image/?$ api/image.php [L,QSA]
  RewriteRule ^api/share/?$ api/share.php [L,QSA]
  RewriteRule ^api/template/?$ api/template.php [L,QSA]
  RewriteRule ^api/oauth/callback/?$ api/oauth-callback.php [L,QSA]
  RewriteRule ^api/connector/callback/?$ api/connector-callback.php [L,QSA]
  RewriteRule ^api/agent-stream/?$ api/agent-stream.php [L]
  RewriteRule ^api/stripe-webhook/?$ api/stripe-webhook.php [L]
  RewriteRule ^api/report/?$ api/report.php [L]
  RewriteRule ^api/telemetry/?$ api/telemetry.php [L]
  RewriteRule ^help/?$ help.html [L]
  RewriteRule ^status/?$ status.html [L]
  RewriteRule ^download/?$ download.html [L]
  RewriteRule ^changelog/?$ changelog.html [L]
  RewriteRule ^pricing/?$ pricing.html [L]
  RewriteRule ^privacy/?$ privacy.html [L]
  RewriteRule ^terms/?$ terms.html [L]
  RewriteRule ^support/?$ support.html [L]
  RewriteRule ^api/health/?$ api/machine.php?op=health [L,QSA]
  RewriteRule ^api/installers/?$ api/machine.php?op=installers [L,QSA]
  RewriteRule ^api/voice/clientlog/?$ api/voice-clientlog.php [L]
  RewriteRule ^api/voice/(voices|speak|transcribe|realtime|usage|quota)/?$ api/voice.php?op=$1 [L,QSA]
  RewriteRule ^themes/theme-host\.js$ assets/theme-host.js [L]
  RewriteRule ^themes/([A-Za-z0-9._-]+)/theme\.css$ assets/themes/$1/theme.css [L]
</IfModule>

# Optional override when the private directory is not the sibling of public_html:
# SetEnv SIMKOSI_PRIVATE /home/u667559395/domains/simkosi.com/simkosi-private

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(mp4)$">
    Header set Cache-Control "public, max-age=2592000"
    Header set Accept-Ranges "bytes"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|css|js|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # Files loaded with a ?v= version string change name on every release: cache them 30 days.
  <If "%{QUERY_STRING} =~ /(^|&)v=/">
    Header set Cache-Control "public, max-age=2592000"
  </If>
  # Security headers for every response.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

<FilesMatch "(^config\.php$|\.sqlite$|\.sqlite-wal$|\.sqlite-shm$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# PWA + store app files (mobile-store branch)
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.webmanifest|offline\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(assetlinks\.json|apple-app-site-association)$">
    Header set Content-Type "application/json"
    Header set Cache-Control "public, max-age=3600"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# Desktop launcher downloads: right type, always a download, short cache so new versions show up.
<IfModule mod_mime.c>
  AddType application/zip .zip
  AddType application/gzip .gz
  RemoveEncoding .gz
</IfModule>
<FilesMatch "^(SimkoSI-Windows\.zip|SimkoSI-macOS\.zip|simkosi-linux\.tar\.gz)$">
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment"
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</FilesMatch>
